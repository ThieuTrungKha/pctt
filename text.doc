```html
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bản đồ tương tác</title>

    <style>
      .zoom-img {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
      }

      .zoom-img.show {
        display: flex;
      }

      .zoom-img img {
        max-width: 90%;
        max-height: 90%;
        object-fit: contain;
      }

      .zoom-img span {
        position: absolute;
        top: 20px;
        right: 30px;
        color: white;
        font-size: 40px;
        cursor: pointer;
      }
      .photo-card img {
        cursor: zoom-in;
        transition: transform 0.3s ease;
      }

      .photo-card img:active {
        transform: scale(2);
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        font-family: Arial, Helvetica, sans-serif;
        background: #111;
      }

      :root {
        --red: #e21d2f;
        --dark: #111827;
        --white: #fff;
      }

      /* =========================
   KHUNG CHÍNH
========================= */

      .app {
        position: relative;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background: #111;
      }

      /* =========================
   MÀN HÌNH TỔNG QUAN
========================= */

      .overview {
        position: absolute;
        inset: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #111;
        transition:
          opacity 0.55s ease,
          visibility 0.55s ease;
      }

      .overview.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      /*
   Bản đồ tổng thể
*/
      .map-wrapper {
        position: relative;
        width: min(96vw, 1800px);
        height: min(94vh, 1000px);

        display: flex;
        align-items: center;
        justify-content: center;

        overflow: visible;
      }

      .map {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;

        transform-origin: 0 0;
        cursor: grab;

        /* Tăng tốc phần cứng GPU, khử răng cưa và chống giật */
        will-change: transform;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        transform: translate3d(0, 0, 0);
      }

      .map img {
        width: 100%;
        height: 100%;

        object-fit: contain;
        user-select: none;
        pointer-events: none;

        filter: contrast(1.03);
      }

      /* =========================
   MARKER
========================= */

      .marker {
        position: absolute;

        width: 15px;
        height: 15px;

        transform: translate(-50%, -50%);

        border: 2px solid #fff;
        border-radius: 50%;

        background: var(--red);

        color: #fff;

        font-size: 6px;
        font-weight: 800;

        display: flex;
        align-items: center;
        justify-content: center;

        cursor: pointer;

        box-shadow:
          0 4px 14px rgba(0, 0, 0, 0.45),
          0 0 0 4px rgba(226, 29, 47, 0.22);

        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;

        z-index: 20;
      }

      .marker:hover {
        transform: translate(-50%, -50%) scale(1.16);

        box-shadow:
          0 6px 18px rgba(0, 0, 0, 0.55),
          0 0 0 7px rgba(226, 29, 47, 0.25);
      }

      .marker::after {
        content: "";
        position: absolute;

        width: 9px;
        height: 9px;

        border-radius: 50%;

        background: #fff;
        opacity: 0.25;
      }

      /* =========================
   VỊ TRÍ 16 ĐIỂM
========================= */

      /*
   QUAN TRỌNG:
   left/top là % trên bản đồ.

   Sau khi có bản đồ thật,
   chỉ cần chỉnh các giá trị này.
*/

      .p01 {
        left: 70%;
        top: 82%;
      }
      .p02 {
        left: 66%;
        top: 72%;
      }
      .p03 {
        left: 62%;
        top: 64%;
      }
      .p04 {
        left: 56%;
        top: 70%;
      }

      .p05 {
        left: 54%;
        top: 76%;
      }
      .p06 {
        left: 60%;
        top: 73%;
      }
      .p07 {
        left: 64%;
        top: 77%;
      }
      .p08 {
        left: 47%;
        top: 69%;
      }

      .p09 {
        left: 47%;
        top: 62%;
      }
      .p10 {
        left: 41%;
        top: 67%;
      }
      .p11 {
        left: 48%;
        top: 43%;
      }
      .p12 {
        left: 37%;
        top: 58%;
      }

      .p13 {
        left: 51%;
        top: 53%;
      }
      .p14 {
        left: 57%;
        top: 60%;
      }
      .p15 {
        left: 33%;
        top: 73%;
      }
      .p16 {
        left: 44%;
        top: 51%;
      }
      .p17 {
        left: 52%;
        top: 49%;
      }
      .p18 {
        left: 48%;
        top: 51%;
      }
      .p19 {
        left: 51%;
        top: 48%;
      }
      .p20 {
        left: 51%;
        top: 60%;
      }
      .p21 {
        left: 30%;
        top: 57%;
      }
      .p22 {
        left: 25%;
        top: 57%;
      }
      .p23 {
        left: 51%;
        top: 50%;
      }
      .p24 {
        left: 55%;
        top: 32%;
      }
      .p25 {
        left: 58%;
        top: 45%;
      }
      .p26 {
        left: 60%;
        top: 70%;
      }
      .p27 {
        left: 62%;
        top: 15%;
      }

      /* =========================
   TIÊU ĐỀ
========================= */

      .title {
        position: absolute;

        left: 40px;
        top: 32px;

        z-index: 30;

        color: #fff;

        padding: 15px 22px;

        background: rgba(17, 24, 39, 0.82);

        border-left: 5px solid var(--red);

        border-radius: 4px;

        backdrop-filter: blur(8px);
      }

      .title h1 {
        font-size: clamp(20px, 2vw, 32px);
        letter-spacing: 0.5px;
      }

      .title p {
        margin-top: 5px;

        font-size: 13px;

        opacity: 0.72;
      }

      /* =========================
   MÀN HÌNH CHI TIẾT
========================= */

      .detail {
        position: absolute;
        inset: 0;

        z-index: 50;

        background: #111;

        opacity: 0;
        visibility: hidden;

        pointer-events: none;

        transition:
          opacity 0.5s ease,
          visibility 0.5s ease;
      }

      .detail.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      /*
   ẢNH ZOOM
*/

      /* =========================================
   ẢNH ZOOM (DETAIL IMAGE)
========================================= */
      .detail-image {
        position: absolute;
        left: 340px;
        top: 50%;
        /* Chiều rộng bằng toàn màn hình trừ đi phần lề 2 bên (340px trái + 340px phải) */
        width: calc(100% - 680px);
        max-width: calc(100% - 680px);
        height: 86vh;

        transform: translateY(-50%) scale(0.92);
        object-fit: contain;
        opacity: 0;

        transition:
          opacity 0.7s ease,
          transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);

        z-index: 20;
      }

      .detail.active .detail-image {
        opacity: 1;
        transform: translateY(-50%) scale(1);
      }
      /* =========================
   VÒNG KHOANH
========================= */

      .highlight {
        position: absolute;

        /* Giảm width và height xuống (ví dụ: 90px hoặc 100px) */
        width: 40px;
        height: 40px;

        border: 3px solid #00e335; /* có thể giảm viền từ 4px xuống 3px */

        border-radius: 50%;

        transform: translate(-50%, -50%) scale(0.4);

        opacity: 0;

        box-shadow:
          0 0 0 4px rgba(29, 226, 78, 0.18),
          0 0 20px rgba(29, 226, 65, 0.45);

        transition:
          transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
          opacity 0.4s ease;

        z-index: 70;

        pointer-events: none;
      }

      .highlight.show {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }

      .highlight::before {
        content: "";

        position: absolute;

        inset: 18px;

        border: 1px dashed rgba(226, 29, 47, 0.65);

        border-radius: 50%;
      }

      /* =========================
   CALL OUT
========================= */

      /* =========================
   CALL OUT
========================= */
      .callout {
        position: absolute;
        left: 30px;
        top: 10px; /* Đẩy sát mép trên một chút */
        width: 280px;
        min-width: 280px;
        max-width: 280px;

        /* --- CÁC THUỘC TÍNH BÓP NHỎ VÀ TẠO SCROLL --- */
        max-height: 225px; /* Giới hạn chiều cao tối đa không vượt quá mép trên của khối ảnh (top: 245px) */
        overflow-y: auto; /* Tự động hiện thanh cuộn nếu văn bản dài */
        overscroll-behavior: contain;
        /* --------------------------------------------- */

        padding: 12px 16px; /* Giảm nhẹ padding cho gọn */
        background: rgba(255, 255, 255, 0.97);
        color: #111827;
        border-radius: 8px;
        border-left: 5px solid #00e335;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
        z-index: 90;
        opacity: 0;
        transform: translateY(-20px);
        transition:
          opacity 0.5s ease,
          transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .callout::-webkit-scrollbar {
        width: 4px;
      }

      .callout::-webkit-scrollbar-thumb {
        background: rgba(0, 0, 0, 0.2);
        border-radius: 4px;
      }
      .callout.show {
        opacity: 1;
        transform: translateY(0);
      }
      /* =========================
   CALLOUT BÊN PHẢI
========================= */

      .right-callout {
        left: auto;
        right: 30px;
      }
      .callout-label {
        font-size: 12px;
        font-weight: 800;

        color: #00e335;

        letter-spacing: 1.5px;

        margin-bottom: 6px;
      }

      .callout-title {
        font-size: 12px;
        font-weight: 800;
        white-space: pre-line;
        line-height: 1.2;
      }

      .callout-text {
        margin-top: 6px;

        font-size: 14px;
        line-height: 1.5;

        color: #4b5563;
      }

      /*
   Đường nối từ callout đến điểm
*/

      .callout-line {
        position: absolute;

        height: 3px;

        background: #00e335;

        transform-origin: left center;

        z-index: 75;

        opacity: 0;

        transition: opacity 0.4s ease;
      }

      .callout-line.show {
        opacity: 1;
      }

      /* =========================
   NÚT QUAY LẠI
========================= */

      .back-button {
        position: absolute;

        left: 30px;
        bottom: 30px;

        z-index: 100;

        border: none;

        padding: 14px 22px;

        border-radius: 6px;

        background: rgba(17, 24, 39, 0.92);

        color: #fff;

        font-size: 14px;
        font-weight: 700;

        cursor: pointer;

        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);

        transition:
          background 0.2s ease,
          transform 0.2s ease;
      }

      .back-button:hover {
        background: #000;
        transform: translateY(-2px);
      }

      /* =========================
   SỐ ĐIỂM TRÊN DETAIL
========================= */

      .detail-number {
        position: absolute;
        top: 25px;
        left: 50%;
        transform: translateX(-50%); /* Đưa ra chính giữa mép trên màn hình */
        z-index: 90;
        padding: 9px 16px;
        border-radius: 4px;
        background: rgba(17, 24, 39, 0.85);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1px;
      }
      /* =========================
   LOADING
========================= */

      .loading {
        position: absolute;

        inset: 0;

        display: flex;

        align-items: center;
        justify-content: center;

        background: #111;

        z-index: 999;

        color: #fff;

        transition: opacity 0.5s ease;
      }

      .loading.hide {
        opacity: 0;
        pointer-events: none;
      }

      .loader {
        width: 42px;
        height: 42px;

        border: 4px solid rgba(255, 255, 255, 0.2);
        border-top-color: #fff;

        border-radius: 50%;

        animation: spin 0.8s linear infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      /* =========================
   RESPONSIVE
========================= */

      /* Đưa các nhóm màu ra ngoài CSS chung để cả Desktop và Mobile đều nhận */
      .marker.group-red {
        background: #e53935;
        color: white;
      }

      .marker.group-orange {
        background: #fb8c00;
        color: white;
      }

      .marker.group-yellow {
        background: #fdd835;
        color: #222;
      }

      .marker.group-blue {
        background: #1e88e5;
        color: white;
      }

      .marker.group-green {
        background: #43a047;
        color: white;
      }

      .marker.group-purple {
        background: #8e44ad;
        color: white;
      }

      /* Phần media query viết lại chuẩn cú pháp phẳng */
      @media (max-width: 700px) {
        .title {
          left: 15px;
          top: 15px;
          padding: 10px 14px;
        }

        .marker {
          width: 40px;
          height: 40px;
          font-size: 13px;
        }

        .callout {
          min-width: 210px;
          max-width: 270px;
        }

        .callout-title {
          font-size: 19px;
        }

        .back-button {
          left: 15px;
          bottom: 15px;
        }
      }
      /* ===== MÀU CÁC NHÓM ĐIỂM ===== */

      /* =========================================
   ẢNH THỰC ĐỊA
========================================= */

      /* =========================================
   ẢNH THỰC ĐỊA (Chuyển sang trái)
========================================= */
      .field-photos {
        position: absolute;
        left: 30px; /* Đặt sang mép trái cùng lề với callout */
        top: 245px; /* Nằm ngay bên dưới callout (hoặc có thể dùng flexbox/chỉnh theo ý muốn) */
        bottom: 85px; /* Giữ khoảng trống cho nút Quay lại ở góc dưới */
        width: 280px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow-y: auto; /* Cuộn nếu màn hình có chiều cao bé */
        padding-right: 4px;
        z-index: 90;
        opacity: 0;
        transform: translateX(-30px);
        transition:
          opacity 0.6s ease 0.3s,
          transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s;
      }

      /* Ẩn scrollbar cho gọn gàng */
      .field-photos::-webkit-scrollbar {
        width: 4px;
      }
      .field-photos::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 4px;
      }

      .detail.active .field-photos {
        opacity: 1;
        transform: translateX(0);
      }
      /* =========================
   ẢNH THỰC ĐỊA BÊN PHẢI
========================= */

      .right-field-photos {
        left: auto;
        right: 30px;
        transform: translateX(30px);
      }

      .detail.active .right-field-photos {
        transform: translateX(0);
      }

      .photo-card {
        position: relative;
        width: 100%;
        height: 110px; /* Giảm nhẹ chiều cao để 3 ảnh vừa vặn hơn */
        flex-shrink: 0;
        overflow: hidden;
        border-radius: 8px;
        background: #222;
        border: 1.5px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.35);
      }

      .photo-card img {
        width: 100%;
        height: 100%;

        object-fit: cover;

        display: block;

        transition: transform 0.35s ease;
      }

      .photo-card:hover img {
        transform: scale(1.06);
      }

      /* Nhãn ảnh */

      .photo-card::after {
        position: absolute;

        left: 10px;
        bottom: 10px;

        padding: 5px 9px;

        border-radius: 4px;

        background: rgba(0, 0, 0, 0.65);

        color: #fff;

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 0.5px;
      }

      .photo-label {
        position: absolute;
        left: 10px;
        bottom: 10px;

        padding: 5px 9px;

        border-radius: 4px;

        background: rgba(0, 0, 0, 0.65);
        color: #fff;

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 0.5px;
      }
      /* =========================================
   ẢNH ZOOM
========================================= */

      /* =========================================
   ẢNH ZOOM (DETAIL IMAGE)
========================================= */
      .detail-image {
        position: absolute;

        left: 340px;
        right: 340px;

        top: 50%;

        width: auto;
        height: 86vh;

        transform: translateY(-50%) scale(0.92);

        object-fit: contain;

        opacity: 0;

        transition:
          opacity 0.7s ease,
          transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);

        z-index: 20;
      }

      .detail.active .detail-image {
        opacity: 1;
        transform: translateY(-50%) scale(1);
      }

      /* =========================================
   RESPONSIVE
========================================= */

      @media (max-width: 900px) {
        .field-photos {
          right: 15px;
          width: 220px;
        }

        .photo-card {
          height: 110px;
        }

        .detail-image {
          left: 15px;

          width: calc(100% - 260px);

          height: calc(100% - 100px);
        }
      }
      /* =========================================
   TÙY CHỈNH MÀU XANH LÁ CHO CỤM BÊN PHẢI
========================================= */

      /* 1. Vòng tròn khoanh bên phải */
      #rightHighlight {
        border-color: #b91010; /* Viền xanh lá */
        box-shadow:
          0 0 0 4px rgba(185, 16, 16, 0.22),
          0 0 20px rgba(185, 33, 16, 0.45);
      }

      #rightHighlight::before {
        border-color: rgba(185, 27, 16, 0.7); /* Viền nét đứt bên trong */
      }

      /* 2. Đường nối (line) bên phải */
      .right-callout-line {
        background: #b92110;
      }

      /* 3. Khung Callout bên phải */
      .right-callout {
        border-left-color: #b91010; /* Viền sọc màu bên trái khung */
      }

      /* 4. Nhãn chữ tiêu đề nhỏ phía trên (ĐIỂM 01 / PHƯƠNG ÁN DI DỜI) */
      .right-callout .callout-label {
        color: #b91010;
      }
      /* =========================
   BẢNG CHÚ THÍCH (MAP LEGEND) HIỆN ĐẠI
========================= */
      .map-legend {
        position: absolute;
        left: 30px;
        bottom: 30px;
        z-index: 100;

        /* Hiệu ứng nền kính tối sang trọng */
        background: rgba(17, 24, 39, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);

        padding: 16px 20px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);

        color: #fff;
        min-width: 170px;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .map-legend:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.6);
      }

      .legend-title {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }

      .legend-item {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 9px 0;
        font-size: 13px;
        font-weight: 500;
        color: #e5e7eb;
        cursor: default;
      }

      /* Chấm tròn màu có viền và hiệu ứng phát sáng nhẹ */
      .legend-color {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        flex-shrink: 0;
        border: 1.5px solid rgba(255, 255, 255, 0.85);
        box-shadow: 0 0 6px rgba(0, 0, 0, 0.4);
      }

      .legend-color.group-red {
        background: #e53935;
        box-shadow: 0 0 8px rgba(229, 57, 53, 0.5);
      }

      .legend-color.group-orange {
        background: #fb8c00;
        box-shadow: 0 0 8px rgba(251, 140, 0, 0.5);
      }

      .legend-color.group-yellow {
        background: #fdd835;
        box-shadow: 0 0 8px rgba(253, 216, 53, 0.5);
      }

      .legend-color.group-blue {
        background: #1e88e5;
        box-shadow: 0 0 8px rgba(30, 136, 229, 0.5);
      }

      .legend-color.group-green {
        background: #43a047;
        box-shadow: 0 0 8px rgba(67, 160, 71, 0.5);
      }

      .legend-title {
        font-weight: 700;
        margin-bottom: 10px;
        font-size: 15px;
      }

      .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 6px 0;
      }

      .legend-color {
        width: 24px; /* Chiều rộng dài hơn để tạo hình chữ nhật */
        height: 12px; /* Chiều cao */
        border-radius: 3px; /* Bo góc nhẹ (nếu muốn vuông sắc cạnh hoàn toàn thì để 0) */
        flex-shrink: 0;
        border: 1px solid rgba(255, 255, 255, 0.4); /* Viền mảnh tạo điểm nhấn */
        display: inline-block;
      }

      .legend-color.group-red {
        background: #e53935;
      }

      .legend-color.group-orange {
        background: #fb8c00;
      }

      .legend-color.group-yellow {
        background: #fdd835;
      }

      .legend-color.group-blue {
        background: #1e88e5;
      }

      .legend-color.group-green {
        background: #43a047;
      }
    </style>
  </head>

  <body>
    <div class="app">
      <!-- LOADING -->
      <div class="loading" id="loading">
        <div class="loader"></div>
      </div>

      <!-- =========================
         BẢN ĐỒ TỔNG QUAN
    ========================== -->

      <section class="overview" id="overview">
        <div class="title">
          <h1>KHU VỰC TRỌNG ĐIỂM</h1>
          <h1>VÀ SƠ TÁN NHÂN DÂN</h1>
        </div>

        <div class="map-wrapper">
          <div class="map-legend">
            <div class="legend-title">PHÂN LOẠI ĐIỂM</div>

            <div class="legend-item">
              <span class="legend-color group-red"></span>
              <span>Nhóm 1</span>
            </div>

            <div class="legend-item">
              <span class="legend-color group-orange"></span>
              <span>Nhóm 2</span>
            </div>

            <div class="legend-item">
              <span class="legend-color group-yellow"></span>
              <span>Nhóm 3</span>
            </div>

            <div class="legend-item">
              <span class="legend-color group-blue"></span>
              <span>Nhóm 4</span>
            </div>

            <div class="legend-item">
              <span class="legend-color group-green"></span>
              <span>Nhóm 5</span>
            </div>
          </div>
          <div class="map" id="map">
            <!-- THAY ẢNH NÀY -->
            <img
              id="mapImage"
              src="assets/map-full.png"
              alt="Bản đồ tổng quan"
            />

            <!-- 16 ĐIỂM -->

            <button class="marker p01 group-red" data-point="1">01</button>
            <button class="marker p02 group-red" data-point="2">02</button>
            <button class="marker p03 group-red" data-point="3">03</button>

            <button class="marker p04 group-red" data-point="4">04</button>
            <button class="marker p05 group-red" data-point="5">05</button>
            <button class="marker p06 group-red" data-point="6">06</button>

            <button class="marker p07 group-red" data-point="7">07</button>
            <button class="marker p08 group-red" data-point="8">08</button>

            <button class="marker p0 group-red" data-point="9">09</button>
            <button class="marker p1 group-red" data-point="10">10</button>

            <button class="marker p11 group-red" data-point="11">11</button>
            <button class="marker p12 group-green" data-point="12">12</button>
            <button class="marker p13 group-green" data-point="13">13</button>
            <button class="marker p14 group-green" data-point="14">14</button>
            <button class="marker p15 group-green" data-point="15">15</button>
            <button class="marker p16 group-green" data-point="16">16</button>
            <button class="marker p17 group-blue" data-point="17">17</button>
            <button class="marker p18 group-blue" data-point="18">18</button>
            <button class="marker p19 group-blue" data-point="19">19</button>
            <button class="marker p20 group-blue" data-point="20">20</button>
            <button class="marker p21 group-blue" data-point="21">21</button>
            <button class="marker p22 group-blue" data-point="22">22</button>
            <button class="marker p23 group-blue" data-point="23">23</button>
            <button class="marker p24 group-yellow" data-point="24">24</button>
            <button class="marker p25 group-yellow" data-point="25">25</button>
            <button class="marker p26 group-yellow" data-point="26">26</button>
            <button class="marker p27 group-yellow" data-point="27">27</button>
          </div>
        </div>
      </section>

      <!-- =========================
         MÀN HÌNH CHI TIẾT
    ========================== -->

      <section class="detail" id="detail">
        <!-- ẢNH ZOOM SẴN -->
        <img class="detail-image" id="detailImage" src="" alt="" />

        <!-- ẢNH THỰC ĐỊA -->
        <div class="field-photos" id="fieldPhotos"></div>
        <!-- 3 ẢNH THỰC ĐỊA BÊN PHẢI -->
        <div
          class="field-photos right-field-photos"
          id="rightFieldPhotos"
        ></div>
        <!-- VÒNG KHOANH -->
        <div class="highlight" id="highlight"></div>
        <!-- VÒNG KHOANH BÊN PHẢI -->
        <div class="highlight" id="rightHighlight"></div>

        <!-- ĐƯỜNG NỐI CALLOUT -->
        <div class="callout-line" id="calloutLine"></div>
        <!-- ĐƯỜNG NỐI BÊN PHẢI -->
        <div
          class="callout-line right-callout-line"
          id="rightCalloutLine"
        ></div>
        <!-- CALLOUT -->
        <div class="callout" id="callout">
          <div class="callout-label" id="calloutLabel">ĐIỂM 01</div>

          <div class="callout-title" id="calloutTitle">Điểm 01</div>

          <div class="callout-text" id="calloutText">
            Nội dung mô tả của điểm.
          </div>
        </div>
        <!-- CALLOUT BÊN PHẢI -->
        <div class="callout right-callout" id="rightCallout">
          <div class="callout-label" id="rightCalloutLabel">ĐIỂM 01</div>

          <div class="callout-title" id="rightCalloutTitle">Điểm 01</div>

          <div class="callout-text" id="rightCalloutText">
            Nội dung mô tả của điểm.
          </div>
        </div>

        <div class="detail-number" id="detailNumber">ĐIỂM 01 / 16</div>

        <button class="back-button" id="backButton">
          ← QUAY LẠI BẢN ĐỒ TỔNG QUAN
        </button>
      </section>
    </div>

