      const rightFieldPhotos = document.getElementById("rightFieldPhotos");

      const rightHighlight = document.getElementById("rightHighlight");

      const rightCallout = document.getElementById("rightCallout");

      const rightCalloutLine = document.getElementById("rightCalloutLine");

      const rightCalloutLabel = document.getElementById("rightCalloutLabel");

      const rightCalloutTitle = document.getElementById("rightCalloutTitle");

      const rightCalloutText = document.getElementById("rightCalloutText");
      const calloutLabel = document.getElementById("calloutLabel");
      const calloutTitle = document.getElementById("calloutTitle");
      const calloutText = document.getElementById("calloutText");

      const detailNumber = document.getElementById("detailNumber");

      const backButton = document.getElementById("backButton");

      const loading = document.getElementById("loading");

      /* ============================================================
   PRELOAD ẢNH
============================================================ */

      function preloadImages() {
        const images = [];

        images.push("assets/map-full.png");

        Object.values(points).forEach((point) => {
          images.push(point.image);
        });

        let loaded = 0;

        images.forEach((src) => {
          const img = new Image();

          img.onload = img.onerror = () => {
            loaded++;

            if (loaded >= images.length) {
              setTimeout(() => {
                loading.classList.add("hide");
              }, 300);
            }
          };

          img.src = src;
        });
      }

      /* ============================================================
   BẮT ĐẦU
============================================================ */

      preloadImages();

      /* ============================================================
   CLICK MARKER
============================================================ */

      document.querySelectorAll(".marker").forEach((marker) => {
        marker.addEventListener("click", () => {
          const number = Number(marker.dataset.point);

          openPoint(number, marker);
        });
      });

      /* ============================================================
   MỞ ĐIỂM
============================================================ */

      function openPoint(number, marker) {
        const point = points[number];

        if (!point) return;

        /*
       Lấy vị trí marker trên màn hình
    */
        const markerRect = marker.getBoundingClientRect();

        /*
       Tọa độ trung tâm marker
    */
        const startX = markerRect.left + markerRect.width / 2;
        const startY = markerRect.top + markerRect.height / 2;

        /*
       Chuẩn bị dữ liệu ảnh chính
    */
        detailImage.src = point.image;
        detailImage.alt = point.title;

        /* ================================
   HÀM RENDER ẢNH THỰC ĐỊA
================================ */
        function renderFieldPhotos(container, photos) {
          container.innerHTML = "";

          if (!photos || photos.length === 0) return;

          photos.forEach((photo) => {
            const card = document.createElement("div");
            card.className = "photo-card";

            const img = document.createElement("img");
            img.src = photo.image;
            img.onclick = () => openZoom(photo.image);

            img.alt = photo.title || "";

            const label = document.createElement("div");
            label.className = "photo-label";
            label.textContent = photo.title || "";

            card.appendChild(img);
            card.appendChild(label);

            container.appendChild(card);
          });
        }

        /* 1. RENDER ẢNH BÊN TRÁI VÀ BÊN PHẢI */
        renderFieldPhotos(fieldPhotos, point.photos);
        // Ưu tiên dùng rightPhotos, nếu không có thì lấy photos chung
        renderFieldPhotos(rightFieldPhotos, point.rightPhotos || point.photos);

        /* 2. NỘI DUNG CALLOUT BÊN TRÁI */
        calloutLabel.textContent =
          point.label || `ĐIỂM ${String(number).padStart(2, "0")}`;
        calloutTitle.textContent = point.title;

        const leftDesc = point.description;
        calloutText.innerHTML = Array.isArray(leftDesc)
          ? leftDesc.map((item) => `- ${item}`).join("<br>")
          : leftDesc || "";

        detailNumber.textContent = `ĐIỂM ${String(number).padStart(2, "0")} / 16`;

        /* 3. NỘI DUNG CALLOUT BÊN PHẢI (DÙNG DỮ LIỆU RIÊNG) */
        rightCalloutLabel.textContent =
          point.rightLabel ||
          point.label ||
          `ĐIỂM ${String(number).padStart(2, "0")}`;

        rightCalloutTitle.textContent = point.rightTitle || point.title;

        const rightDesc = point.rightDescription || point.description;
        rightCalloutText.innerHTML = Array.isArray(rightDesc)
          ? rightDesc.map((item) => `- ${item}`).join("<br>")
          : rightDesc || "";

        /*
       Hiện màn hình detail
    */
        detail.classList.add("active");
        overview.classList.add("hidden");

        /*
       Reset animation
    */
        highlight.classList.remove("show");
        callout.classList.remove("show");
        calloutLine.classList.remove("show");

        rightHighlight.classList.remove("show");
        rightCallout.classList.remove("show");
        rightCalloutLine.classList.remove("show");

        /*
       Đợi ảnh detail render
    */
        detailImage.onload = () => {
          requestAnimationFrame(() => {
            positionHighlight(point);
          });
        };

        /*
       Nếu ảnh đã cache
    */
        if (detailImage.complete) {
          setTimeout(() => {
            positionHighlight(point);
          }, 50);
        }
      }
      /* ============================================================
   ĐẶT VÒNG KHOANH & VẼ ĐƯỜNG NỐI
============================================================ */

      function positionHighlight(point) {
        // Tọa độ vòng tròn bên trái
        const x = point.focus.x;
        const y = point.focus.y;

        // Tọa độ vòng tròn bên phải (nếu không khai báo rightFocus thì lấy chung focus)
        const rx = point.rightFocus ? point.rightFocus.x : point.focus.x;
        const ry = point.rightFocus ? point.rightFocus.y : point.focus.y;

        const imageRect = detailImage.getBoundingClientRect();

        // Tính vị trí pixel thực tế trên màn hình
        const targetX = imageRect.left + imageRect.width * (x / 100);
        const targetY = imageRect.top + imageRect.height * (y / 100);

        const rightTargetX = imageRect.left + imageRect.width * (rx / 100);
        const rightTargetY = imageRect.top + imageRect.height * (ry / 100);

        // Gán vị trí cho vòng tròn trái
        highlight.style.left = `${targetX}px`;
        highlight.style.top = `${targetY}px`;

        // Gán vị trí cho vòng tròn phải
        rightHighlight.style.left = `${rightTargetX}px`;
        rightHighlight.style.top = `${rightTargetY}px`;

        setTimeout(() => {
          highlight.classList.add("show");
          rightHighlight.classList.add("show");
        }, 250);

        // Nối dây callout vào đúng từng vòng đỏ tương ứng
        positionCallout(targetX, targetY);
        positionRightCallout(rightTargetX, rightTargetY);
      }
      function positionCallout(targetX, targetY) {
        callout.style.left = "30px";
        callout.style.top = "5px"; // Đặt ở top 30px thay vì 50%

        setTimeout(() => {
          callout.classList.add("show");
          drawCalloutLine(targetX, targetY);
        }, 600);
      }
      function positionRightCallout(targetX, targetY) {
        rightCallout.style.left = "auto";

        rightCallout.style.right = "30px";

        rightCallout.style.top = "30px";

        setTimeout(() => {
          rightCallout.classList.add("show");

          drawRightCalloutLine(targetX, targetY);
        }, 600);
      }

      function drawCalloutLine(targetX, targetY) {
        const calloutRect = callout.getBoundingClientRect();

        // Điểm bắt đầu: mép phải giữa khung callout
        const startX = calloutRect.right;
        const startY = calloutRect.top + calloutRect.height / 2;

        // Khoảng cách và góc nghiêng nối thẳng vào tâm vòng tròn đỏ
        const dx = targetX - startX;
        const dy = targetY - startY;

        const distance = Math.sqrt(dx * dx + dy * dy);
        const angle = (Math.atan2(dy, dx) * 180) / Math.PI;

        calloutLine.style.left = `${startX}px`;
        calloutLine.style.top = `${startY}px`;
        calloutLine.style.width = `${distance}px`;
        calloutLine.style.transform = `rotate(${angle}deg)`;

        calloutLine.classList.add("show");
      }
      function drawRightCalloutLine(targetX, targetY) {
        const rect = rightCallout.getBoundingClientRect();

        // Bắt đầu từ mép trái callout phải
        const startX = rect.left;

        const startY = rect.top + rect.height / 2;

        const dx = targetX - startX;

        const dy = targetY - startY;

        const distance = Math.sqrt(dx * dx + dy * dy);

        const angle = (Math.atan2(dy, dx) * 180) / Math.PI;

        rightCalloutLine.style.left = `${startX}px`;

        rightCalloutLine.style.top = `${startY}px`;

        rightCalloutLine.style.width = `${distance}px`;

        rightCalloutLine.style.transform = `rotate(${angle}deg)`;

        rightCalloutLine.classList.add("show");
      }
      /* ============================================================
   QUAY LẠI
============================================================ */

      backButton.addEventListener("click", closePoint);

      function closePoint() {
        /*
       Ẩn các thành phần detail
    */

        highlight.classList.remove("show");

        callout.classList.remove("show");

        calloutLine.classList.remove("show");
        rightHighlight.classList.remove("show");

        rightCallout.classList.remove("show");

        rightCalloutLine.classList.remove("show");
        /*
       Tắt màn hình detail
    */

        detail.classList.remove("active");

        /*
       Đợi animation rồi hiện bản đồ
    */

        setTimeout(() => {
          overview.classList.remove("hidden");
        }, 250);
      }

      /* ============================================================
   ESC = QUAY LẠI
============================================================ */

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          if (detail.classList.contains("active")) {
            closePoint();
          }
        }
      });

      /* ============================================================
   RESPONSIVE
============================================================ */

      window.addEventListener("resize", () => {
        if (detail.classList.contains("active")) {
          const currentLabel = detailNumber.textContent;

          const number = parseInt(currentLabel.match(/\d+/)[0]);

          if (points[number]) {
            positionHighlight(points[number]);
          }
        }
      });
      /* ============================================================
   TOOL LẤY TỌA ĐỘ CLICK TRỰC TIẾP
============================================================ */
      detailImage.style.cursor = "crosshair"; // Đổi con trỏ thành dấu cộng để ngắm chuẩn hơn

      detailImage.addEventListener("click", (e) => {
        const rect = detailImage.getBoundingClientRect();

        // Tính tỷ lệ phần trăm theo ảnh hiển thị
        const clickX = e.clientX - rect.left;
        const clickY = e.clientY - rect.top;

        const percentX = Math.round((clickX / rect.width) * 100);
        const percentY = Math.round((clickY / rect.height) * 100);

        // 1. Cho vòng tròn đỏ nhảy ngay đến vị trí vừa click để xem thử
        highlight.style.left = `${e.clientX}px`;
        highlight.style.top = `${e.clientY}px`;
        positionCallout(e.clientX, e.clientY);

        // 2. In ra console và tự động copy đoạn code
        const result = `focus: { x: ${percentX}, y: ${percentY} },`;
        console.log(
          "%c Tọa độ vừa chọn: " + result,
          "color: #10b981; font-weight: bold; font-size: 14px;",
        );

        navigator.clipboard.writeText(result).then(() => {
          alert(
            `Đã copy tọa độ vào bộ nhớ:\n${result}\nChỉ cần paste vào điểm tương ứng!`,
          );
        });
      });
      /* ============================================================
   ZOOM & PAN BẢN ĐỒ TỔNG QUAN (TỐI ƯU GPU - SIÊU MƯỢT)
============================================================ */
      const mapEl = document.getElementById("map");
      const mapWrapper = document.querySelector(".map-wrapper");

      let mapScale = 1;
      let mapTranslateX = 0;
      let mapTranslateY = 0;
      let isMapDragging = false;
      let mapStartDragX = 0;
      let mapStartDragY = 0;
      let rafId = null;

      // Hàm cập nhật toạ độ tối ưu phần cứng qua GPU
      function applyMapTransform() {
        mapEl.style.transform = `translate3d(${mapTranslateX}px, ${mapTranslateY}px, 0) scale(${mapScale})`;
        rafId = null;
      }

      function requestMapUpdate() {
        if (!rafId) {
          rafId = requestAnimationFrame(applyMapTransform);
        }
      }

      // 1. Lăn chuột để phóng to / thu nhỏ
      mapWrapper.addEventListener(
        "wheel",
        function (e) {
          if (detail.classList.contains("active")) return;
          e.preventDefault();

          const rect = mapEl.getBoundingClientRect();
          const mouseX = e.clientX - rect.left;
          const mouseY = e.clientY - rect.top;

          const zoomFactor = e.deltaY < 0 ? 1.15 : 0.85;
          let newScale = Math.min(Math.max(1, mapScale * zoomFactor), 6);

          if (newScale === 1) {
            mapScale = 1;
            mapTranslateX = 0;
            mapTranslateY = 0;
            requestMapUpdate();
            return;
          }

          const ratio = 1 - newScale / mapScale;
          mapTranslateX += mouseX * ratio;
          mapTranslateY += mouseY * ratio;
          mapScale = newScale;

          requestMapUpdate();
        },
        { passive: false },
      );

      // 2. Kéo thả di chuyển (Pan) với requestAnimationFrame
      mapWrapper.addEventListener("mousedown", function (e) {
        if (detail.classList.contains("active")) return;

        // Nếu click trúng marker thì không kích hoạt kéo map
        if (e.target.closest(".marker")) return;

        if (mapScale > 1) {
          isMapDragging = true;
          mapStartDragX = e.clientX - mapTranslateX;
          mapStartDragY = e.clientY - mapTranslateY;
          mapEl.style.cursor = "grabbing";
        }
      });

      window.addEventListener("mousemove", function (e) {
        if (!isMapDragging) return;
        mapTranslateX = e.clientX - mapStartDragX;
        mapTranslateY = e.clientY - mapStartDragY;
        requestMapUpdate();
      });

      window.addEventListener("mouseup", function () {
        if (isMapDragging) {
          isMapDragging = false;
          mapEl.style.cursor = "grab";
        }
      });
    </script>
    <div class="zoom-img" id="zoomImg">
      <span onclick="closeZoom()">×</span>
      <img id="zoomImage" />
    </div>

    <script>
      function openZoom(src) {
        document.getElementById("zoomImage").src = src;
        document.getElementById("zoomImg").classList.add("show");
      }

      function closeZoom() {
        document.getElementById("zoomImg").classList.remove("show");
      }

      document.getElementById("zoomImg").onclick = function (e) {
        if (e.target === this) {
          closeZoom();
        }
      };
    </script>
  </body>
</html>
```
