          description: "Nội dung mô tả của điểm 14.",
          image: "assets/point-14.jpg",
          focus: { x: 50, y: 50 },
        },

        15: {
          title: "Điểm 15",
          description: "Nội dung mô tả của điểm 15.",
          image: "assets/point-15.jpg",
          focus: { x: 50, y: 50 },
        },

        16: {
          title: "Điểm 16",
          description: "Nội dung mô tả của điểm 16.",
          image: "assets/point-16.jpg",
          focus: { x: 50, y: 50 },
        },
      };

      /* ============================================================
   ELEMENTS
============================================================ */

      const overview = document.getElementById("overview");
      const detail = document.getElementById("detail");

      const detailImage = document.getElementById("detailImage");
      const fieldPhotos = document.getElementById("fieldPhotos");
      const highlight = document.getElementById("highlight");

      const callout = document.getElementById("callout");
      const calloutLine = document.getElementById("calloutLine");
      const rightFieldPhotos = document.getElementById("rightFieldPhotos");

      const rightHighlight = document.getElementById("rightHighlight");

      const rightCallout = document.getElementById("rightCallout");

      const rightCalloutLine = document.getElementById("rightCalloutLine");

      const rightCalloutLabel = document.getElementById("rightCalloutLabel");

      const rightCalloutTitle = document.getElementById("rightCalloutTitle");

      const rightCalloutText = document.getElementById("rightCalloutText");
      const calloutLabel = document.getElementById("calloutLabel");
      const calloutTitle = document.getElementById("calloutTitle");
      const calloutText = document.getElementById("calloutText");

      const detailNumber = document.getElementById("detailNumber");

      const backButton = document.getElementById("backButton");

      const loading = document.getElementById("loading");

      /* ============================================================
   PRELOAD ẢNH
============================================================ */

      function preloadImages() {
        const images = [];

        images.push("assets/map-full.png");

        Object.values(points).forEach((point) => {
          images.push(point.image);
        });

        let loaded = 0;

        images.forEach((src) => {
          const img = new Image();

          img.onload = img.onerror = () => {
            loaded++;

            if (loaded >= images.length) {
              setTimeout(() => {
                loading.classList.add("hide");
              }, 300);
            }
          };

          img.src = src;
        });
      }

      /* ============================================================
   BẮT ĐẦU
============================================================ */

      preloadImages();

      /* ============================================================
   CLICK MARKER
============================================================ */

      document.querySelectorAll(".marker").forEach((marker) => {
        marker.addEventListener("click", () => {
          const number = Number(marker.dataset.point);

          openPoint(number, marker);
        });
      });

      /* ============================================================
   MỞ ĐIỂM
============================================================ */

      function openPoint(number, marker) {
        const point = points[number];

        if (!point) return;

        /*
       Lấy vị trí marker trên màn hình
    */

        const markerRect = marker.getBoundingClientRect();

        /*
       Tọa độ trung tâm marker
    */

        const startX = markerRect.left + markerRect.width / 2;

        const startY = markerRect.top + markerRect.height / 2;

        /*
       Chuẩn bị dữ liệu
    */

        detailImage.src = point.image;

        detailImage.alt = point.title;
        /* ================================
   LOAD ẢNH THỰC ĐỊA
================================ */

        function renderFieldPhotos(container, photos) {
          container.innerHTML = "";

          if (!photos || photos.length === 0) return;

          photos.forEach((photo) => {
            const card = document.createElement("div");
            card.className = "photo-card";

            const img = document.createElement("img");
            img.src = photo.image;
            img.alt = photo.title || "";

            const label = document.createElement("div");
            label.className = "photo-label";
            label.textContent = photo.title || "";

            card.appendChild(img);
            card.appendChild(label);

            container.appendChild(card);
          });
        }

        renderFieldPhotos(fieldPhotos, point.photos);
        renderFieldPhotos(rightFieldPhotos, point.photos);
        calloutLabel.textContent =
          point.label || `ĐIỂM ${String(number).padStart(2, "0")}`;
        calloutTitle.textContent = point.title;

        calloutText.innerHTML = point.description
          .map((item) => `- ${item}`)
          .join("<br>");
        detailNumber.textContent = `ĐIỂM ${String(number).padStart(2, "0")} / 16`;
        rightCalloutLabel.textContent =
          point.label || `ĐIỂM ${String(number).padStart(2, "0")}`;

        rightCalloutTitle.textContent = point.title;

        rightCalloutText.innerHTML = point.description
          .map((item) => `- ${item}`)
          .join("<br>");
        /*
       Hiện màn hình detail
    */

        detail.classList.add("active");

        overview.classList.add("hidden");

        /*
       Reset animation
    */

        highlight.classList.remove("show");

        callout.classList.remove("show");

        calloutLine.classList.remove("show");

        /*
       Đợi ảnh detail render
    */

        detailImage.onload = () => {
          requestAnimationFrame(() => {
            positionHighlight(point);
          });
        };

        /*
       Nếu ảnh đã cache
    */

        if (detailImage.complete) {
          setTimeout(() => {
            positionHighlight(point);
          }, 50);
        }
      }

      /* ============================================================
   ĐẶT VÒNG KHOANH & VẼ ĐƯỜNG NỐI
============================================================ */

      function positionHighlight(point) {
        const x = point.focus.x;
        const y = point.focus.y;

        const imageRect = detailImage.getBoundingClientRect();

        const targetX = imageRect.left + imageRect.width * (x / 100);
        const targetY = imageRect.top + imageRect.height * (y / 100);

        highlight.style.left = `${targetX}px`;
        highlight.style.top = `${targetY}px`;

        rightHighlight.style.left = `${targetX}px`;
        rightHighlight.style.top = `${targetY}px`;

        setTimeout(() => {
          highlight.classList.add("show");
          rightHighlight.classList.add("show");
        }, 250);

        positionCallout(targetX, targetY);
        positionRightCallout(targetX, targetY);
      }
      function positionCallout(targetX, targetY) {
        callout.style.left = "30px";
        callout.style.top = "30px"; // Đặt ở top 30px thay vì 50%

        setTimeout(() => {
          callout.classList.add("show");
          drawCalloutLine(targetX, targetY);
        }, 600);
      }
      function positionRightCallout(targetX, targetY) {
        rightCallout.style.left = "auto";

        rightCallout.style.right = "30px";

        rightCallout.style.top = "30px";

        setTimeout(() => {
          rightCallout.classList.add("show");

          drawRightCalloutLine(targetX, targetY);
        }, 600);
      }

      function drawCalloutLine(targetX, targetY) {
        const calloutRect = callout.getBoundingClientRect();

        // Điểm bắt đầu: mép phải giữa khung callout
        const startX = calloutRect.right;
        const startY = calloutRect.top + calloutRect.height / 2;

        // Khoảng cách và góc nghiêng nối thẳng vào tâm vòng tròn đỏ
        const dx = targetX - startX;
        const dy = targetY - startY;

        const distance = Math.sqrt(dx * dx + dy * dy);
        const angle = (Math.atan2(dy, dx) * 180) / Math.PI;

        calloutLine.style.left = `${startX}px`;
        calloutLine.style.top = `${startY}px`;
        calloutLine.style.width = `${distance}px`;
        calloutLine.style.transform = `rotate(${angle}deg)`;

        calloutLine.classList.add("show");
      }
      function drawRightCalloutLine(targetX, targetY) {
        const rect = rightCallout.getBoundingClientRect();

        // Bắt đầu từ mép trái callout phải
        const startX = rect.left;

        const startY = rect.top + rect.height / 2;

        const dx = targetX - startX;

        const dy = targetY - startY;

        const distance = Math.sqrt(dx * dx + dy * dy);

        const angle = (Math.atan2(dy, dx) * 180) / Math.PI;

        rightCalloutLine.style.left = `${startX}px`;

        rightCalloutLine.style.top = `${startY}px`;

        rightCalloutLine.style.width = `${distance}px`;

        rightCalloutLine.style.transform = `rotate(${angle}deg)`;

        rightCalloutLine.classList.add("show");
      }
      /* ============================================================
   QUAY LẠI
============================================================ */

      backButton.addEventListener("click", closePoint);

      function closePoint() {
        /*
       Ẩn các thành phần detail
    */

        highlight.classList.remove("show");

        callout.classList.remove("show");

        calloutLine.classList.remove("show");
        rightHighlight.classList.remove("show");

        rightCallout.classList.remove("show");

        rightCalloutLine.classList.remove("show");
        /*
       Tắt màn hình detail
    */

        detail.classList.remove("active");

        /*
       Đợi animation rồi hiện bản đồ
    */

        setTimeout(() => {
          overview.classList.remove("hidden");
        }, 250);
      }

      /* ============================================================
   ESC = QUAY LẠI
============================================================ */

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          if (detail.classList.contains("active")) {
            closePoint();
          }
        }
      });

      /* ============================================================
   RESPONSIVE
============================================================ */

      window.addEventListener("resize", () => {
        if (detail.classList.contains("active")) {
          const currentLabel = detailNumber.textContent;

          const number = parseInt(currentLabel.match(/\d+/)[0]);

          if (points[number]) {
            positionHighlight(points[number]);
          }
        }
      });
    </script>
  </body>
</html>
```
